---
layout: base.njk
seccion: noticias
---
{%- set enlace = urlSitio + '/noticias/' + page.fileSlug + '/' -%}
<header class="pag-cab articulo-cab">
  <div class="pag-cab-inner">
    <a href="/#noticias" class="migas">Noticias</a>
    <div class="articulo-meta"><span class="tag">{{ category }}</span><time datetime="{{ date }}">{{ date | fecha }}</time></div>
    <h1>{{ title }}</h1>
  </div>
</header>

<div class="articulo">
  <article class="articulo-cuerpo">
    {%- if image %}<img src="{{ image }}" alt="" class="articulo-img" loading="lazy" onerror="this.remove()">{% endif %}
    <div class="cuerpo">
      {{ content | safe }}
    </div>
    {%- if url %}
    <p><a href="{{ url }}" target="_blank" rel="noopener" class="btn-oro btn-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>{{ cta or "Ver más" }}</a></p>
    {%- endif %}
    <div class="compartir">
      <span>Compartir</span>
      <a href="https://wa.me/?text={{ (title + ' ' + enlace) | urlencode }}" target="_blank" rel="noopener" aria-label="Compartir por WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3z"/></svg></a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ enlace | urlencode }}" target="_blank" rel="noopener" aria-label="Compartir en Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.87.24-1.5 1.53-1.5H16.5V4.3c-.28-.04-1.23-.12-2.33-.12-2.3 0-3.87 1.4-3.87 3.98V10.5H8v3h2.3V21h3.2z"/></svg></a>
      <a href="https://twitter.com/intent/tweet?url={{ enlace | urlencode }}&text={{ title | urlencode }}" target="_blank" rel="noopener" aria-label="Compartir en X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.3 8.3L23.3 22H16.7l-5.2-6.8L5.5 22H2.4l7.8-8.9L1.7 2h6.8l4.7 6.2L18.9 2z"/></svg></a>
    </div>
  </article>

  <aside class="relacionadas">
    <h2>Últimas noticias</h2>
    {%- for n in collections.noticias | reverse | limit(4) -%}
    {%- if n.fileSlug != page.fileSlug %}
    <a href="/noticias/{{ n.fileSlug }}/" class="relacionada">
      <span class="nota-meta"><span class="nota-tag">{{ n.data.category }}</span><span>{{ n.data.date | fecha }}</span></span>
      <span class="relacionada-titulo">{{ n.data.title }}</span>
    </a>
    {%- endif -%}
    {%- endfor %}
    <a href="/#noticias" class="enlace-verde">Ver todas las noticias <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </aside>
</div>
