<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "CESM Valladolid · Sindicato médico de Valladolid" }}</title>
<meta name="description" content="{{ descripcion or 'CESM Valladolid, sindicato médico de Valladolid integrado en CESM Castilla y León. Defendemos los derechos de los médicos.' }}">
<link rel="icon" href="/icono-cesm.png" type="image/png">
<link rel="apple-touch-icon" href="/icono-cesm.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{%- set dis = diseno or {} %}
{%- set col = dis.colores or {} %}
{%- set tip = dis.tipografia or {} %}
{%- set frm = dis.formas or {} %}
{%- set avi = dis.aviso or {} %}
{%- set fuente = tip.fuente or "Lato" %}
<link href="https://fonts.googleapis.com/css2?family={{ fuente | replace(' ', '+') }}:ital,wght@0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
<style>
:root{
  --verde:{{ col.verde or "#0c3316" }};
  --verde-hondo:{{ col.verde_hondo or "#071f0d" }};
  --verde-medio:{{ col.verde_medio or "#3a6741" }};
  --oro:{{ col.oro or "#e9a94a" }};
  --oro-claro:{{ col.oro_claro or "#f3c77f" }};
  --papel:{{ col.papel or "#f1f5ef" }};
  --tinta:{{ col.tinta or "#16241a" }};
  --sans:"{{ fuente }}","Carlito",system-ui,-apple-system,"Segoe UI",sans-serif;
  --radio:{{ frm.radio_tarjetas or 14 }}px;
  --radio-boton:{{ frm.radio_botones or 6 }}px;
  --lado:{{ frm.ancho_lateral or 3.5 }}%;
  --aviso-fondo:{{ avi.fondo or "#e9a94a" }};
  --aviso-texto:{{ avi.texto or "#071f0d" }};
  --aviso-tamano:{{ avi.tamano or 0.92 }}rem;
}
html{font-size:{{ tip.tamano_base or 17 }}px}
</style>
<script>document.documentElement.classList.add('js');</script>
</head>
<body>

<!-- CABECERA FIJA: barra superior + menú + aviso -->
<div id="cabecera">
  <div class="topbar">
    <div class="topbar-izq">
      <a href="tel:+34983218524">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
        983 218 524
      </a>
      <a href="mailto:cesmvalladolid@cesmcyl.es">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        cesmvalladolid@cesmcyl.es
      </a>
      <span class="redes">
        <a href="{{ contacto.redes.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        <a href="{{ contacto.redes.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.58h-3.16v13.68c0 1.5-1.22 2.72-2.72 2.72s-2.72-1.22-2.72-2.72 1.22-2.72 2.72-2.72c.3 0 .59.05.86.14V9.94a5.9 5.9 0 00-.86-.06c-3.24 0-5.86 2.62-5.86 5.86S6.16 21.6 9.4 21.6s5.86-2.62 5.86-5.86V9.05a7.24 7.24 0 004.22 1.35V7.24c-1 0-1.94-.35-2.68-.94l-.2-.48z"/></svg></a>
        <a href="{{ contacto.redes.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.87.24-1.5 1.53-1.5H16.5V4.3c-.28-.04-1.23-.12-2.33-.12-2.3 0-3.87 1.4-3.87 3.98V10.5H8v3h2.3V21h3.2z"/></svg></a>
        <a href="{{ contacto.redes.x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.3 8.3L23.3 22H16.7l-5.2-6.8L5.5 22H2.4l7.8-8.9L1.7 2h6.8l4.7 6.2L18.9 2z"/></svg></a>
        <a href="{{ contacto.redes.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3-5.2 3z"/></svg></a>
      </span>
    </div>
    <div class="topbar-der">
      <a href="{{ textos.campus_destino or "https://www.cesmcyl.org/formacion-tiscyl-cesm/" }}" target="_blank" rel="noopener">{{ textos.topbar_campus or "Campus TISCYL-CESM" }}</a>
      <a href="/admin/">{{ textos.topbar_admin or "Acceso admin" }}</a>
    </div>
  </div>

  <nav class="nav" id="navbar" aria-label="Menú principal">
    <a href="/" class="logo"><img src="/logo-cesm-vll-hq.png" alt="CESM Valladolid" width="496" height="242"></a>
    <button type="button" class="hamburguesa" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="navLinks"><span></span><span></span><span></span></button>
    <ul class="menu" id="navLinks">
      <li><a href="/#inicio" data-seccion="inicio"{% if page.url == "/" %} class="activo"{% endif %}>{{ textos.menu_inicio or "Inicio" }}</a></li>
      <li><a href="/#noticias" data-seccion="noticias"{% if seccion == "noticias" %} class="activo"{% endif %}>{{ textos.menu_noticias or "Noticias" }}</a></li>
      <li><a href="/#quienes" data-seccion="quienes">{{ textos.menu_quienes or "Quiénes somos" }}</a></li>
      <li class="desplegable">
        <a href="/#servicios" data-seccion="servicios"{% if seccion == "servicios" %} class="activo"{% endif %}>{{ textos.menu_servicios or "Servicios" }}<span class="flechita" aria-hidden="true"></span></a>
        <ul class="submenu">
          {%- for serv in collections.servicios | principales %}
          {%- set hijasMenu = collections.servicios | hijasDe(serv.fileSlug) | unir(collections.paginas | hijasDe(serv.fileSlug)) %}
          <li><a href="{{ serv.data.destino or serv.url }}">{{ serv.data.menu or serv.data.title }}</a>
            {%- if hijasMenu | length %}
            <ul class="submenu-hijas">
              {%- for h in hijasMenu %}
              <li><a href="{{ h.data.destino or h.url }}">{{ h.data.menu or h.data.title }}</a></li>
              {%- endfor %}
            </ul>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>
      </li>
      <li><a href="/#contacto" data-seccion="contacto">{{ textos.menu_contacto or "Contacto" }}</a></li>
      <li><a href="/afiliate/" class="btn-afiliate">{{ textos.menu_afiliate or "Afíliate" }}</a></li>
      <li class="solo-movil"><a href="{{ textos.campus_destino or "https://www.cesmcyl.org/formacion-tiscyl-cesm/" }}" target="_blank" rel="noopener">{{ textos.topbar_campus or "Campus TISCYL-CESM" }}</a></li>
      <li class="solo-movil"><a href="/admin/">{{ textos.topbar_admin or "Acceso admin" }}</a></li>
      <li class="solo-movil menu-contacto">
        <a href="tel:{{ contacto.telefono_enlace }}">{{ contacto.telefono }}</a>
        <a href="mailto:{{ contacto.email }}">{{ contacto.email }}</a>
        {% include "redes.njk" %}
      </li>
    </ul>
  </nav>

  <div class="aviso vacio" id="ticker">
    <span class="aviso-etiqueta" id="ticker-label" style="display:none"><span class="punto"></span>Aviso</span>
    <span class="aviso-texto" id="ticker-text"></span>
    <a href="/huelga/" class="aviso-enlace" id="ticker-flecha" style="display:none">Toda la información <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div>
</div>

<main id="contenido-pagina">
{{ content | safe }}
</main>

<footer class="pie">
  <div class="pie-inner">
    <div class="pie-marca">
      <img src="/logo-cesm-vll-hq.png" alt="CESM Valladolid" width="496" height="242">
      <p>{{ pie.descripcion or "Sindicato médico de Valladolid, integrado en CESM Castilla y León y en CESM." }}</p>
    </div>
    <div class="pie-col" role="navigation" aria-label="CESM Valladolid">
      <h4>{{ pie.titulo_columna1 or "CESM Valladolid" }}</h4>
      {%- for e in pie.enlaces_columna1 %}
      <a href="{{ e.destino }}">{{ e.texto }}</a>
      {%- endfor %}
    </div>
    <div class="pie-col" role="navigation" aria-label="Servicios">
      <h4>{{ pie.titulo_servicios or "Servicios" }}</h4>
      {%- for serv in collections.servicios | principales %}
      <a href="{{ serv.data.destino or serv.url }}">{{ serv.data.menu or serv.data.title }}</a>
      {%- endfor %}
    </div>
    <div class="pie-col">
      <h4>{{ pie.titulo_contacto or "Contacto" }}</h4>
      <a href="tel:{{ contacto.telefono_enlace }}">{{ contacto.telefono }}</a>
      <a href="mailto:{{ contacto.email }}">{{ contacto.email }}</a>
      <p>{{ contacto.direccion | nl2br | safe }}</p>
      {% include "redes.njk" %}
    </div>
  </div>

  <div class="pie-barra">
    <span>© {{ anio }} {{ pie.copyright or "CESM Valladolid · Sindicato médico de Valladolid" }}</span>
    <span class="pie-legal">
      {%- for e in pie.enlaces_legales %}
      <a href="{{ e.destino }}">{{ e.texto }}</a>
      {%- endfor %}
    </span>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
