<!-- TICKER (aviso urgente) -->
<div class="ticker vacio" id="ticker">
  <div class="ticker-inner">
  <div class="ticker-msg">
  <span class="ticker-label" id="ticker-label" style="display:none;">
    <span class="ticker-dot" aria-hidden="true"></span>
    Aviso
  </span>
  <span class="ticker-text" id="ticker-text"></span>
  </div>
  <a href="/huelga/" class="ticker-flecha" id="ticker-flecha" style="display:none;" aria-label="Más información sobre la huelga">
    <span class="ticker-flecha-texto">Toda la información<br>de la huelga</span>
    <span class="ticker-flecha-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </span>
  </a>
  <button type="button" class="ticker-toggle" id="ticker-toggle" aria-label="Mostrar u ocultar los detalles del aviso">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  </div>
</div>

<script>
  // La franja del aviso se queda pegada bajo el menú al bajar la página,
  // encogida a una versión compacta. Se puede volver a abrir del todo
  // pulsando la flechita, sin necesidad de subir arriba.
  (function () {
    var ticker = document.getElementById('ticker');
    var boton = document.getElementById('ticker-toggle');
    if (!ticker) return;

    function fijarAlturaNav() {
      var nav = document.querySelector('nav');
      if (nav) {
        document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
      }
    }
    fijarAlturaNav();
    window.addEventListener('resize', fijarAlturaNav);

    var UMBRAL = 80;
    function actualizarEncogido() {
      if (window.scrollY > UMBRAL) {
        ticker.classList.add('encogido');
      } else {
        ticker.classList.remove('encogido');
        ticker.classList.remove('forzado-abierto');
      }
    }
    window.addEventListener('scroll', actualizarEncogido, { passive: true });
    actualizarEncogido();

    if (boton) {
      boton.addEventListener('click', function (e) {
        e.preventDefault();
        ticker.classList.toggle('forzado-abierto');
      });
    }
  })();
</script>

