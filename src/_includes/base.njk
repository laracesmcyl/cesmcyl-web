<script>
  // La franja del aviso se queda pegada bajo el menú al bajar la página,
  // encogida a una versión compacta. Se puede volver a abrir del todo
  // pulsando la flechita, sin necesidad de subir arriba.
  (function () {
    var ticker = document.getElementById('ticker');
    if (!ticker) return;

    // Cabecera compacta (barra verde + menú más finos) al bajar la página,
    // con dos umbrales distintos para que no "vibre". Las alturas de cada
    // estado están fijadas en el CSS (variables --topbar-height y
    // --nav-height), no se miden por JavaScript, para evitar que se
    // recalculen en bucle mientras se hace scroll.
    // La cabecera (barra verde + menú + aviso) ahora "flota" fija sobre la
    // página en vez de empujar el contenido (position:fixed), para evitar
    // el bucle de vibración que causaba al cambiar de tamaño en mitad del
    // scroll. Como consecuencia, hay que dejarle el hueco correspondiente
    // arriba de la página a mano, con este margen. OJO: esto se mide solo
    // al cargar, al cambiar el tamaño de ventana, y cuando cambia el aviso
    // (activo/inactivo) — nunca durante el scroll, para no repetir el
    // problema de antes.
    // Medimos las alturas REALES de la topbar y el menú, en sus dos
    // versiones (normal y compacta), UNA sola vez al cargar la página
    // (nunca durante el scroll, que es lo que causaba la vibración de
    // antes). Así no hace falta calcular a mano cada vez que se retoca
    // el CSS, y evitamos que la barra blanca se quede corta y se pise
    // con lo de al lado.
    // La cabecera (barra verde + menú + aviso) va dentro de un único
    // envoltorio fijo (#cabecera-fija) donde las tres piezas se apilan
    // solas, sin ningún cálculo de alturas — así se evita el desajuste
    // (y la vibración) que daba el método anterior.
    function ajustarEspacioContenido() {
      var cabecera = document.getElementById('cabecera-fija');
      var contenido = document.getElementById('contenido-pagina');
      if (!cabecera || !contenido) return;
      contenido.style.marginTop = cabecera.offsetHeight + 'px';
    }
    window.addEventListener('load', ajustarEspacioContenido);
    window.addEventListener('resize', ajustarEspacioContenido);
    ajustarEspacioContenido();
    // El aviso carga sus datos de forma asíncrona (fetch al JSON) y puede
    // cambiar de "vacío" a "con contenido" después de cargar la página;
    // cuando eso pase, el hueco tiene que volver a calcularse una vez.
    new MutationObserver(ajustarEspacioContenido).observe(ticker, { attributes: true, attributeFilter: ['class'] });
    setTimeout(ajustarEspacioContenido, 500);
    setTimeout(ajustarEspacioContenido, 1500);

    var UMBRAL_CABECERA_COMPACTA = 60;
    var UMBRAL_CABECERA_NORMAL = 15;
    var cabeceraTickeando = false;
    function actualizarCabecera() {
      var y = window.scrollY;
      var estabaCompacta = document.body.classList.contains('cabecera-compacta');
      var debeSerCompacta = estabaCompacta;
      if (y > UMBRAL_CABECERA_COMPACTA) {
        debeSerCompacta = true;
      } else if (y < UMBRAL_CABECERA_NORMAL) {
        debeSerCompacta = false;
      }
      if (debeSerCompacta !== estabaCompacta) {
        document.body.classList.toggle('cabecera-compacta', debeSerCompacta);
        // Al cambiar de tama\u00f1o, el envoltorio cambia de altura; esperamos
        // a que termine la transici\u00f3n (0.3s) antes de volver a medir.
        window.setTimeout(ajustarEspacioContenido, 320);
      }
      cabeceraTickeando = false;
    }
    window.addEventListener('scroll', function () {
      if (!cabeceraTickeando) {
        cabeceraTickeando = true;
        requestAnimationFrame(actualizarCabecera);
      }
    }, { passive: true });
    actualizarCabecera();

    var UMBRAL_ENCOGER = 130;
    var UMBRAL_ABRIR = 40;
    var tickeando = false;
    function actualizarEncogido() {
      var y = window.scrollY;
      if (y > UMBRAL_ENCOGER) {
        ticker.classList.add('encogido');
      } else if (y < UMBRAL_ABRIR) {
        ticker.classList.remove('encogido');
      }
      // Entre los dos umbrales no tocamos nada: así no "vibra" si el
      // scroll se queda justo en medio.
      tickeando = false;
    }
    window.addEventListener('scroll', function () {
      if (!tickeando) {
        tickeando = true;
        requestAnimationFrame(actualizarEncogido);
      }
    }, { passive: true });
    actualizarEncogido();
  })();
</script>

