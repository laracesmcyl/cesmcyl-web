---
layout: base.njk
title: "CESM Valladolid · Sindicato médico de Valladolid"
---
{%- import "iconos-servicio.njk" as ico -%}
{%- set flecha = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>' -%}
{%- set externo = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>' -%}

<!-- ============ PRIMERA PANTALLA ============ -->
<section class="hero" id="inicio">
  <div class="hero-foto" aria-hidden="true"></div>
  <div class="hero-velo" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-texto">
      <p class="hero-firma entra" style="--d:.1s"><svg class="pulso" viewBox="0 0 74 22" aria-hidden="true"><path d="M1 13h22l4-8 5 15 5-19 4 12 3-2h29"/></svg>{{ inicio.firma }}</p>
      <h1 class="hero-titulo">
        <span class="linea"><span style="--d:.2s">{{ inicio.titulo_linea1 }}</span></span>
        <span class="linea"><span style="--d:.34s">{{ inicio.titulo_linea2 }}<em>{{ inicio.titulo_destacado2 }}</em></span></span>
        <span class="linea"><span style="--d:.48s"><em>{{ inicio.titulo_destacado3 }}</em></span></span>
      </h1>
      <p class="hero-lead entra" style="--d:.8s">{{ inicio.lead }}</p>
      <div class="hero-acciones entra" style="--d:.95s">
        <a href="{{ inicio.boton_principal.destino }}" class="btn-oro">{{ inicio.boton_principal.texto }}</a>
        <a href="{{ inicio.boton_secundario.destino }}" class="enlace-blanco">{{ inicio.boton_secundario.texto }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
      </div>
    </div>

    <!-- TABLÓN -->
    <aside class="tablon" aria-label="Tablón">
      <h2 class="tablon-cab entra" style="--d:.6s">Tablón</h2>

      {%- set grupos = collections.tablon | porCategoria %}
      {%- if grupos | length %}
      <div class="tablon-destacados entra" style="--d:.72s">
        <h3 class="tablon-sub">Últimos documentos</h3>
        {%- if grupos | length > 1 %}
        <div class="pestanas" role="tablist" aria-label="Temas del tablón">
          {%- for g in grupos %}
          <button type="button" class="pestana{% if loop.first %} activa{% endif %}" role="tab" data-grupo="{{ g.nombre | slugify }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ g.nombre | corto }}<span class="cuenta">{{ g.elementos | length }}</span></button>
          {%- endfor %}
        </div>
        {%- endif %}
        {%- for g in grupos %}
        <div class="grupo-fijos{% if loop.first %} visible{% endif %}{% if g.elementos | length > 1 %} apilado{% endif %}" data-grupo="{{ g.nombre | slugify }}" role="tabpanel">
          {%- for item in g.elementos %}
          {%- set destino = item.data.archivo or item.data.enlace %}
          {%- if destino %}
          <a href="{{ destino }}" class="fijo"{% if item.data.enlace and not item.data.archivo %} target="_blank" rel="noopener"{% else %} download{% endif %}>
            <span class="fijo-cab">
              {%- set etiqueta = item.data | cat %}
              {% if etiqueta %}<span class="tag">{{ etiqueta }}</span>{% else %}<span></span>{% endif %}
              <svg class="chincheta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-label="Fijado"><path d="M9 4v6l-2 4h10l-2-4V4M12 14v6M8 4h8"/></svg>
            </span>
            <span class="fijo-titulo">{{ item.data.title }}</span>
            {%- if item.data.descripcion %}<span class="fijo-desc">{{ item.data.descripcion }}</span>{% endif %}
            <span class="descarga">
              {%- if item.data.archivo %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>
              {%- else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
              {%- endif %}
              {{ item.data.texto_boton or ("Descargar" if item.data.archivo else "Ver más") }}
            </span>
          </a>
          {%- endif %}
          {%- endfor %}
          {%- if g.elementos | length > 1 %}
          <button type="button" class="abrir-pila" aria-expanded="false">
            <span class="abrir-texto">Ver los {{ g.elementos | length }} documentos</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      {%- endif %}

      {%- set noticiasCarrusel = collections.noticias | reverse | limit(8) %}
      <div class="tn-cab entra" style="--d:.95s">
        <span>Últimas noticias</span>
        <div class="flechas">
          <button type="button" id="carrusel-anterior" aria-label="Noticia anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg></button>
          <span class="contador" id="carrusel-contador">1 / {{ noticiasCarrusel | length }}</span>
          <button type="button" id="carrusel-siguiente" aria-label="Noticia siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </div>
      <div class="tn-marco entra" style="--d:1.05s" id="carrusel">
        {%- for noticia in noticiasCarrusel %}
        <a href="/noticias/{{ noticia.fileSlug }}/" class="tn{% if loop.first %} visible{% endif %}">
          <span class="tn-meta"><b>{% if (noticia.data | cat) != "Noticias" %}{{ noticia.data | cat }}{% endif %}</b><span>{{ noticia.data.date | fecha }}</span></span>
          <span class="tn-titulo">{{ noticia.data.title }}</span>
          <span class="tn-desc">{{ noticia.data.description or (noticia.templateContent | excerpt(150)) }}</span>
        </a>
        {%- endfor %}
        <span class="progreso" id="carrusel-progreso"></span>
      </div>

    </aside>
  </div>
</section>

<!-- ============ NOTICIAS ============ -->
<section class="noticias" id="noticias">
  <div class="noticias-top">
    <div>
      <h2 class="titulo-seccion">Noticias</h2>
      <p class="sub-seccion">Convocatorias, listados y actualidad sindical, según se publican.</p>
    </div>
    <label class="buscador">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input type="search" id="buscador-noticias" placeholder="Buscar noticias" aria-label="Buscar noticias">
    </label>
  </div>
  <div class="chips" role="group" aria-label="Filtrar noticias por tema">
    <button type="button" class="chip activo" data-cat="todas">Todas</button>
    {%- for g in collections.noticias | reverse | categoriasAgrupadas(listaCategorias) %}
    {%- if g.subs | length %}
    <div class="chip-grupo">
      <button type="button" class="chip chip-con-menu" data-cat="{{ g.nombre | slugify }}" aria-expanded="false">{{ g.nombre }}<svg class="chip-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
      <div class="chip-menu">
        {%- for sub in g.subs %}
        <button type="button" class="chip-sub" data-cat="{{ sub.completo | slugify }}">{{ sub.corto }}</button>
        {%- endfor %}
      </div>
    </div>
    {%- else %}
    <button type="button" class="chip" data-cat="{{ g.nombre | slugify }}">{{ g.nombre }}</button>
    {%- endif %}
    {%- endfor %}
  </div>
  <div class="notas" id="notas">
    {%- for noticia in collections.noticias | reverse %}
    <article class="nota" data-cat="{{ noticia.data | cat | slugify }}" data-grupo="{{ noticia.data | cat | grupo | slugify }}">
      <div class="nota-meta"><span class="nota-tag">{% if (noticia.data | cat) != "Noticias" %}{{ noticia.data | cat }}{% endif %}</span><time datetime="{{ noticia.data.date }}">{{ noticia.data.date | fecha }}</time></div>
      <h3><a href="/noticias/{{ noticia.fileSlug }}/">{{ noticia.data.title }}</a></h3>
      <p>{{ noticia.data.description or (noticia.templateContent | excerpt(170)) }}</p>
      <span class="nota-leer" aria-hidden="true">Leer más {{ flecha | safe }}</span>
    </article>
    {%- endfor %}
  </div>
  <p class="notas-vacio" id="notas-vacio" hidden>No hay noticias que coincidan con la búsqueda.</p>
  <div class="notas-pie"><button type="button" class="btn-mas" id="btn-mas">Ver más noticias</button></div>
  <div class="acciones-seccion">
    <a href="/afiliate/" class="btn-oro">Afíliate</a>
    <a href="/#contacto" class="enlace-verde">Contacta con nosotros {{ flecha | safe }}</a>
    {% include "redes.njk" %}
  </div>
</section>

<!-- ============ QUIÉNES SOMOS ============ -->
<section class="quienes" id="quienes">
  <div class="quienes-inner">
    <div>
      <h2 class="titulo-seccion">{{ quienes.titulo }}</h2>
      <p class="intro">{{ quienes.intro | md | safe }}</p>
      {%- if quienes.lema %}<p class="lema">{{ quienes.lema }}</p>{% endif %}
    </div>
    {%- if quienes.objetivos | length %}
    <div class="objetivos">
      <h3>{{ quienes.titulo_objetivos or "Nuestros objetivos" }}</h3>
      <ol>
        {%- for o in quienes.objetivos %}
        <li><span>{{ o.texto | md | safe }}</span></li>
        {%- endfor %}
      </ol>
    </div>
    {%- endif %}
  </div>
  <div class="acciones-seccion">
    <a href="/afiliate/" class="btn-oro">Afíliate</a>
    <a href="/#contacto" class="enlace-verde">Contacta con nosotros {{ flecha | safe }}</a>
    {% include "redes.njk" %}
  </div>
</section>

<!-- ============ SERVICIOS ============ -->
<section class="servicios" id="servicios">
  <div class="servicios-top">
    <div>
      <h2 class="titulo-seccion">{{ servicios.titulo }}</h2>
      <p>{{ servicios.intro }}</p>
    </div>
  </div>
  <div class="serv-grid-paginas">
    {%- for serv in collections.servicios | principales %}
    {%- set destino = serv.data.destino or serv.url %}
    {%- set esPropiaSeccion = destino == "/#servicios" %}
    {%- set hijas = collections.servicios | hijasDe(serv.fileSlug) %}
    <article class="serv-tarjeta{% if hijas | length %} con-hijas{% endif %}{% if esPropiaSeccion %} serv-tarjeta-fija{% endif %}">
      <div class="serv-tarjeta-cuerpo">
        {{ ico.icono(serv.data.icono) }}
        <h3>{% if esPropiaSeccion %}{{ serv.data.menu or serv.data.title }}{% else %}<a href="{{ destino }}" class="serv-tarjeta-principal">{{ serv.data.menu or serv.data.title }}</a>{% endif %}</h3>
        {%- if serv.data.entradilla %}<p>{{ serv.data.entradilla }}</p>{% endif %}
        {%- if esPropiaSeccion %}
        <span class="serv-tarjeta-contacto">
          <a href="tel:{{ contacto.telefono_enlace }}">{{ contacto.telefono }}</a>
          <a href="mailto:{{ contacto.email }}">{{ contacto.email }}</a>
        </span>
        {%- else %}
        <span class="serv-tarjeta-ir">Ver más {{ flecha | safe }}</span>
        {%- endif %}
      </div>
      {%- if hijas | length %}
      <div class="serv-tarjeta-sub">
        <span class="serv-tarjeta-sub-titulo">Dentro encontrarás</span>
        {%- for h in hijas %}
        <a href="{{ h.data.destino or h.url }}">{{ h.data.menu or h.data.title }} {{ flecha | safe }}</a>
        {%- endfor %}
      </div>
      {%- endif %}
    </article>
    {%- endfor %}
  </div>

  <div class="acciones-seccion">
    <a href="/afiliate/" class="btn-oro">Afíliate</a>
    <a href="/#contacto" class="enlace-blanco">Contacta con nosotros {{ flecha | safe }}</a>
    {% include "redes.njk" %}
  </div>
</section>

<!-- ============ CONTACTO ============ -->
<section class="contacto" id="contacto">
  <div class="contacto-info">
    <h2 class="titulo-seccion">{{ contacto.titulo }}</h2>
    <p class="sub-seccion">{{ contacto.intro }}</p>
    <ul class="datos">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg><div><span>Teléfono</span><a href="tel:{{ contacto.telefono_enlace }}">{{ contacto.telefono }}</a></div></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><div><span>Correo electrónico</span><a href="mailto:{{ contacto.email }}">{{ contacto.email }}</a></div></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><div><span>Sede</span><p>{{ contacto.direccion | nl2br | safe }}</p></div></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div><span>Horario</span><p>{{ contacto.horario }}</p></div></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg><div><span>CESM Castilla y León</span><a href="{{ contacto.web_cesmcyl }}" target="_blank" rel="noopener">{{ contacto.web_cesmcyl | sinProtocolo }}</a></div></li>
    </ul>

    <div class="contacto-redes" id="redes">
      <h3>Conoce nuestras redes</h3>
      <p>Síguenos y entérate al momento de convocatorias, plazos y movilizaciones.</p>
      <div class="redes-botones">
      <a href="{{ contacto.redes.instagram }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>Instagram</a>
      <a href="{{ contacto.redes.facebook }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.87.24-1.5 1.53-1.5H16.5V4.3c-.28-.04-1.23-.12-2.33-.12-2.3 0-3.87 1.4-3.87 3.98V10.5H8v3h2.3V21h3.2z"/></svg>Facebook</a>
      <a href="{{ contacto.redes.tiktok }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.58h-3.16v13.68c0 1.5-1.22 2.72-2.72 2.72s-2.72-1.22-2.72-2.72 1.22-2.72 2.72-2.72c.3 0 .59.05.86.14V9.94a5.9 5.9 0 00-.86-.06c-3.24 0-5.86 2.62-5.86 5.86S6.16 21.6 9.4 21.6s5.86-2.62 5.86-5.86V9.05a7.24 7.24 0 004.22 1.35V7.24c-1 0-1.94-.35-2.68-.94l-.2-.48z"/></svg>TikTok</a>
      <a href="{{ contacto.redes.x }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.3 8.3L23.3 22H16.7l-5.2-6.8L5.5 22H2.4l7.8-8.9L1.7 2h6.8l4.7 6.2L18.9 2z"/></svg>X</a>
      <a href="{{ contacto.redes.youtube }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3-5.2 3z"/></svg>YouTube</a>
    </div>
    </div>
  </div>

  <form class="formulario" id="formulario" novalidate>
    <h3>Envíanos un mensaje</h3>
    <div class="campos">
      <label>Nombre<input type="text" name="nombre" autocomplete="given-name" required></label>
      <label>Apellidos<input type="text" name="apellidos" autocomplete="family-name" required></label>
      <label>Correo electrónico<input type="email" name="email" autocomplete="email" placeholder="nombre@correo.es" required></label>
      <label><span>Teléfono <em>(opcional)</em></span><input type="tel" name="telefono" autocomplete="tel" placeholder="600 000 000"></label>
      <label class="ancho">Provincia
        <select name="provincia">
          <option>Ávila</option><option>Burgos</option><option>León</option><option>Palencia</option><option>Salamanca</option><option>Segovia</option><option>Soria</option><option selected>Valladolid</option><option>Zamora</option>
        </select>
      </label>
      <label class="ancho">Mensaje<textarea name="mensaje" rows="5" placeholder="Cuéntanos en qué podemos ayudarte" required></textarea></label>
    </div>
    <label class="casilla"><input type="checkbox" name="privacidad" required><span>Acepto que CESM Valladolid use estos datos únicamente para responder a mi consulta.</span></label>
    <p class="form-error" id="form-error" role="alert"></p>
    <button type="submit" class="btn-oro btn-enviar">Enviar mensaje</button>
    <p class="form-nota">Al enviar se abrirá tu programa de correo con el mensaje ya preparado para <b>cesmvalladolid@cesmcyl.es</b>.</p>
    <p class="form-ok" id="form-ok" role="status"></p>
  </form>

  {%- set publicaciones = collections.tablon | enRedes %}
  {%- if publicaciones | length %}
  <div class="contacto-publicaciones">
    <h3>Lo último que hemos publicado</h3>
    <div class="redes-grid">
    {%- for pub in publicaciones | limit(4) %}
    <a href="{{ pub.data.enlace or pub.data.archivo }}" target="_blank" rel="noopener" class="pub">
      <span class="pub-foto">
        {%- if pub.data.imagen %}<img src="{{ pub.data.imagen }}" alt="" loading="lazy">{% endif %}
        {% if pub.data | cat %}<span class="pub-red">{{ pub.data | cat }}</span>{% endif %}
      </span>
      <span class="pub-texto">{{ pub.data.title }}{% if pub.data.descripcion %} — {{ pub.data.descripcion }}{% endif %}</span>
      <span class="pub-ir">{{ pub.data.texto_boton or "Ver publicación" }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></span>
    </a>
    {%- endfor %}
    </div>
  </div>
  {%- endif %}
</section>
